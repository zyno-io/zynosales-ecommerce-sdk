{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/generated/sales/index.ts"],
  "exclude": ["test/**"],
  "plugin": ["typedoc-plugin-markdown"],
  "out": "docs/api",
  "readme": "none",
  "entryFileName": "index",
  "excludeInternal": true,
  "disableSources": true,
  "hideBreadcrumbs": true,
  "hidePageHeader": true,
  "validation": {
    "notExported": false
  }
}
